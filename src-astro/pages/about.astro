---
/**
 * Spike target. Copy and class names are taken verbatim from
 * src/pages/AboutPage.jsx so the rendered page is comparable to the live one.
 *
 * Existing React components are imported and rendered WITHOUT a client:*
 * directive, so Astro executes them at build time and emits plain HTML — no
 * React is shipped to the browser. That is the "REUSE AS-IS" claim from the
 * phase 0 blueprint, tested rather than asserted.
 *
 * ExecCta is deliberately absent: it imports react-router-dom's <Link>, which
 * throws outside a Router during SSR. That is the "MINOR ADAPTATION" tier, and
 * it is out of scope for this spike.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../../src/components/sections/PageHero.jsx";
---

<BaseLayout metaKey="about.html">
  <PageHero
    label="About Immersia"
    title="Evidence that moves into decisions, systems, and action."
  />

  <section class="white">
    <div class="wrap split">
      <img
        loading="lazy"
        src="/assets/photos/practice1.webp"
        alt="Immersia facilitators working with a partner organization"
      />
      <div>
        <h2>Who We Are</h2>
        <p class="lead">
          Immersia is an impact advisory and capacity-building firm working
          across organization, program/project, and people domains.
        </p>
        <p>
          We help institutions connect credible evidence with practical systems,
          program decisions, and lasting capability.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <h2>Why Immersia Exists</h2>
        <p>
          Organizations often invest in research, evaluation, and training
          without building the systems needed to use the results. Immersia
          closes the gap between analysis and action.
        </p>
      </div>
      <img
        class="about-exists-photo"
        src="/assets/photos/general26.webp"
        alt="Immersia team facilitating a validation workshop"
      />
    </div>
  </section>

  <section class="white about-icons">
    <div class="wrap">
      <h2>Who We Work With</h2>
      <div class="five">
        <b>Development agencies</b>
        <b>NGOs and CSOs</b>
        <b>Government institutions</b>
        <b>Corporations and state-owned enterprises</b>
        <b>Foundations and social enterprises</b>
      </div>
    </div>
  </section>

  <section class="about-icons">
    <div class="wrap">
      <h2>What Makes Immersia Different</h2>
      <div class="four approach">
        <article>
          <h3>Context First</h3>
          <p>
            Begin with actual capacity, stakeholders, constraints, and operating
            conditions.
          </p>
        </article>
        <article>
          <h3>Research-Grounded</h3>
          <p>
            Fit evidence approaches to the decision question and available data.
          </p>
        </article>
        <article>
          <h3>Designed for Execution</h3>
          <p>
            Account for ownership, timelines, systems, and operational reality.
          </p>
        </article>
        <article>
          <h3>Systemic Continuity</h3>
          <p>
            Build frameworks and capabilities that remain usable after the
            engagement.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="white">
    <div class="wrap split">
      <img
        loading="lazy"
        src="/assets/photos/practice5.webp"
        alt="An Immersia field team conducting participant interviews"
      />
      <div>
        <h2>How We Work</h2>
        <ol>
          <li>Understand the context</li>
          <li>Design the approach</li>
          <li>Deliver with stakeholders</li>
          <li>Evaluate and learn</li>
          <li>Support continuity</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
