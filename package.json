{
  "name": "immersia-vite-final",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{jsx,js,css}\" index.html vite.config.js",
    "format:check": "prettier --check \"src/**/*.{jsx,js,css}\" index.html vite.config.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "3.5.3",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10"
  }
}
