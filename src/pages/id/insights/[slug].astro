---
/**
 * One restored article from the Indonesian archive.
 *
 * These pages exist to honour the URLs the WordPress site published in March
 * 2026 and the SPA migration dropped. They are noindex, absent from the
 * sitemap, and reachable only from /id/insights.html and the 301s in
 * vercel.json — nothing on the live English site links into them.
 *
 * noindex is set explicitly rather than left to the fixed-page table: that
 * table returns its not-found record for any key it does not know, which is
 * exactly the accident that marked every article and publication noindex in
 * phase 4. Saying it here means the archive's robots value is a decision, not
 * a side effect.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../../lib/page-meta.js";

export async function getStaticPaths() {
  const entries = await getCollection("legacy");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);

const published = a.pubDate.toISOString().slice(0, 10);
const readable = a.pubDate.toLocaleDateString("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  metaKey={`id/insights/${entry.id}.html`}
  title={a.title}
  description={a.excerpt}
  type="article"
  lang="id"
  noindex={true}
>
  <header class="articlehero archivehero">
    <div class="wrap">
      <small>Arsip · {a.category}</small>
      <h1>{a.title}</h1>
    </div>
  </header>

  <article class="articlebody">
    <p class="archivenote">
      Artikel ini terbit di situs Immersia versi sebelumnya pada <time
        datetime={published}>{readable}</time
      > dan dipulihkan apa adanya sebagai arsip. Isinya tidak diperbarui. Tulisan
      terbaru kami dalam bahasa Inggris ada di <a href="/news.html"
        >News &amp; Articles</a
      >.
    </p>

    <div class="prose">
      <Content />
    </div>

    <p class="archivemeta">
      Ditulis oleh {a.author} · {a.category} · <a href="/id/insights.html"
        >Semua artikel arsip</a
      >
    </p>
  </article>
</BaseLayout>

<style>
  /* The live .articlehero composes its gradient over a per-article photo. The
     archive has no photos to compose over — the originals were never captured
     by the archiver — so it states the gradient itself rather than leaving
     background-image invalid and falling back to flat carbon. */
  .archivehero {
    min-height: 420px;
    padding: 148px 0 56px;
    background-image: linear-gradient(96deg, #2a2e30, #31444d);
  }

  .archivenote {
    margin: 0 0 40px;
    padding: 16px 20px;
    border-left: 3px solid var(--gold, #b08d4f);
    background: #f6f4f0;
    border-radius: 0 8px 8px 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .archivemeta {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid #e2ddd5;
    font-size: 0.9rem;
    color: #6a6a6a;
  }
</style>
