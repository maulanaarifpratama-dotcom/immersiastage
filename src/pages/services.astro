---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Icon from "../components/Icon.jsx";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<PageLayout
  metaKey="services.html"
  label="Services"
  title="Designed around where impact happens."
>
  <section>
    <div class="wrap three">
      {
        services.map(({ id, data: s }) => (
          <article class="service">
            <img loading="lazy" src={s.cardImage} alt="" width="360" height="190" />
            <div>
              <small>{s.label}</small>
              {/* h2, not h3: these cards are the page's top-level sections and
                  they sit above the CTA's own h2, so h3 both skipped a level
                  and inverted the outline. Every other card page — publications,
                  project records, news — already uses h2 here, and the styling
                  is written as `.service :is(h2, h3, h4)`, so nothing moves. */}
              <h2>{s.title}</h2>
              <p>{s.summary}</p>
              <a href={`/${id}.html`}>
                Explore Service
                <Icon name="arrowRight" size={17} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</PageLayout>
