---
/**
 * Renders the head at BUILD time from the same data the SPA writes at runtime.
 *
 * The metadata structure is reused from the SPA; only the mechanism that
 * writes it changes. There, useDocumentMeta() mutates document.head after
 * React mounts; here the same resolved object is interpolated into static HTML
 * that a crawler sees without running any JS.
 *
 * It reads src/lib/page-meta.js rather than src/lib/meta.js so the Astro build
 * has no import path to src/data/*, which still backs the legacy SPA.
 */
import { resolvePageMeta, SITE_URL, SITE_NAME } from "../lib/page-meta.js";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.jsx";
import "../styles/site.css";

interface Props {
  /** Route key as used by src/lib/page-meta.js, e.g. "about.html". */
  metaKey: string;
  /**
   * Content-driven pages pass their own metadata instead of looking it up.
   * Articles and publications come from collections, so the fixed-page table
   * is not the source of truth for them.
   */
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | null;
  noindex?: boolean;
  /**
   * BCP 47 tag for <html lang>. Everything live is English; the restored
   * Indonesian archive under /id/insights/ passes "id" so screen readers and
   * translation tools do not read Indonesian prose with English rules.
   */
  lang?: string;
}

const {
  metaKey,
  title: titleOverride,
  description: descOverride,
  image: imageOverride,
  type: typeOverride,
  jsonLd = null,
  noindex: noindexOverride,
  lang = "en",
} = Astro.props;

const meta = resolvePageMeta(metaKey);
const path = metaKey === "index.html" ? "/" : `/${metaKey}`;
const url = `${SITE_URL}${path}`;

/**
 * resolvePageMeta() only knows the fixed pages, so it returns the not-found
 * record for any article or publication slug. Reading `noindex` straight off it
 * marked all eleven of those pages `noindex` and stripped their canonical —
 * while the sitemap listed them. A page that supplies its own title is a real
 * page, whatever the fixed-page table thinks of its key.
 */
const noindex = noindexOverride ?? (meta.noindex && !titleOverride);

const baseTitle = titleOverride ?? meta.title;
const description = descOverride ?? meta.description;
const image = imageOverride ?? meta.image ?? `${SITE_URL}/og-image.jpg`;
const ogType = typeOverride ?? meta.type;
const fullTitle =
  metaKey === "index.html" ? baseTitle : `${baseTitle} — ${SITE_NAME}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    {/*
      Google Tag Manager — GTM-TM9VB4ZQ. Google asks for this as high in the
      head as possible, so it goes first.

      Worth knowing: what GTM loads is decided in Google's console, not here.
      Adding a tag there changes what every page of this site fetches and
      stores without any commit, any review, or any CI run. The privacy policy
      says so rather than listing third parties it cannot keep current.
    */}
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-TM9VB4ZQ");
    </script>

    {/*
      Google tag (gtag.js) — G-0RFC45PYLN.
      Google asks for this immediately after <head>, so it sits above even the
      charset meta.

      This runs alongside GTM on purpose, because both were requested. If a
      GA4 configuration tag for G-0RFC45PYLN is ever also added inside GTM,
      every pageview will be counted twice.

      This is the first third-party script the site has ever loaded, and the
      first thing to write to a visitor's device. /privacy-policy.html was
      written when neither was true and says so in as many words, so it changes
      in the same commit — a policy that describes a site that no longer exists
      is worse than no policy. docs/legal-architecture-notes.md predicted this
      exact dependency; it is why that file exists.
    */}
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0RFC45PYLN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-0RFC45PYLN");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page gets no canonical: pointing search engines at a URL we
        are simultaneously telling them to ignore is a contradiction. */}
    {!noindex && <link rel="canonical" href={url} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#31444d" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/inter-latin.woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    {/*
      Google Tag Manager noscript fallback. Hidden, 0x0, and inert without
      JavaScript disabled -- but it is still an iframe to a third party, so the
      privacy policy names it rather than claiming the site embeds nothing.

      It sits above the skip link because Google specifies immediately after
      <body>; aria-hidden and tabindex keep it out of the accessibility tree
      and the tab order, so the skip link is still the first thing a keyboard
      or screen reader user reaches.
    */}
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TM9VB4ZQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        aria-hidden="true"
        tabindex="-1"></iframe>
    </noscript>

    <a class="skiplink" href="#main">Skip to content</a>

    {/*
      Navigation is an .astro component with a small inline enhancement script,
      not a framework island. Footer is React with no client:* directive, so it
      renders to static HTML at build time and ships nothing.
    */}
    <Navigation pathname={path} />

    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
