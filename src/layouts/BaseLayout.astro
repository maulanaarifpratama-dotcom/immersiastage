---
/**
 * Renders the head at BUILD time from the same data the SPA writes at runtime.
 *
 * `resolveMeta`, `SITE_URL` and `SITE_NAME` are imported from the existing
 * src/lib/meta.js unchanged — the metadata structure is reused, only the
 * mechanism that writes it changes. In the SPA that file's useDocumentMeta()
 * mutates document.head after React mounts; here the same resolved object is
 * interpolated into static HTML that a crawler sees without running any JS.
 */
import { resolveMeta, SITE_URL, SITE_NAME } from "../lib/meta.js";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.jsx";
import "../styles/site.css";

interface Props {
  /** Route key as used by src/lib/meta.js, e.g. "about.html". */
  metaKey: string;
  /**
   * Content-driven pages pass their own metadata instead of looking it up.
   * Articles and publications now come from collections, so resolveMeta()'s
   * copy of that data is no longer the source of truth for them.
   */
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | null;
}

const {
  metaKey,
  title: titleOverride,
  description: descOverride,
  image: imageOverride,
  type: typeOverride,
  jsonLd = null,
} = Astro.props;

const meta = resolveMeta(metaKey);
const path = metaKey === "index.html" ? "/" : `/${metaKey}`;
const url = `${SITE_URL}${path}`;

const baseTitle = titleOverride ?? meta.title;
const description = descOverride ?? meta.description;
const image = imageOverride ?? meta.image ?? `${SITE_URL}/og-image.jpg`;
const ogType = typeOverride ?? meta.type;
const fullTitle =
  metaKey === "index.html" ? baseTitle : `${baseTitle} — ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page gets no canonical: pointing search engines at a URL we
        are simultaneously telling them to ignore is a contradiction. */}
    {!meta.noindex && <link rel="canonical" href={url} />}
    <meta name="robots" content={meta.noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#31444d" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/inter-latin.woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <a class="skiplink" href="#main">Skip to content</a>

    {/*
      The only hydrated island on these pages. Navigation carries the mobile
      drawer and the two keyboard-operable submenus, so it needs client JS;
      client:load rather than client:visible because it sits above the fold and
      a visitor can reach for the menu before any observer fires.

      Footer below has no directive, so it renders to static HTML at build time
      and ships nothing.
    */}
    <Navigation pathname={path} />

    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
